* {
    bg:      #1b2027cc;   /* last 2 hex digits = opacity */
    fg:      #cdd6dc;
    accent:  #7fb7a4;
    dim:     #89939e;
    pill:    #2a4a40;
    line:    #7fb7a466;
    font:    "JetBrainsMono Nerd Font 10";
}

window {
    location: north;
    anchor: north;
    y-offset: 100px;
    x-offset: 0px;

    width: 640px;
    background-color: @bg;
    border: 1px;
    border-color: @line;
    border-radius: 8px;
}

mainbox {
    children: [inputbar, listview];
    spacing: 0;
    background-color: transparent;
}

inputbar {
    children: [entry];
    padding: 12px 18px;
    background-color: transparent;
}

entry {
    placeholder: "Search...";
    placeholder-color: @dim;
    text-color: @fg;
    cursor-color: @accent;
    background-color: transparent;
}

listview {
    require-input: true;
    fixed-height: false;
    dynamic: true;
    lines: 6;
    scrollbar: false;
    padding: 0 10px 10px 10px;
    spacing: 4px;
    background-color: transparent;
}

element {
    padding: 10px 12px;
    border-radius: 20px;
    background-color: transparent;
    text-color: @fg;
}

element selected.normal {
    background-color: @pill;
    text-color: #ffffff;
}

element-icon {
    size: 24px;
    margin: 0 10px 0 0;
    background-color: transparent;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
}