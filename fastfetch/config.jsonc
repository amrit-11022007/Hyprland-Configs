{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "arch",
    "color": {
      "1": "38;2;127;183;164",
      "2": "38;2;127;183;164"
    },
    "padding": {
      "top": 1,
      "right": 4
    }
  },
  "display": {
    "color": {
      "keys": "38;2;127;183;164",
      "title": "38;2;127;183;164"
    },
    "percent": {
      "type": 3
    },
    "bar": {
      "char": {
        "elapsed": "■",
        "total": "·"
      },
      "border": {
        "left": "[ ",
        "right": " ]"
      },
      "width": 12
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "Hey, {#38;2;127;183;164}Amrit{#}"
    },
    "break",
    { "type": "cpu", "key": "CPU   " },
    { "type": "gpu", "key": "GPU   " },
    { "type": "memory", "key": "RAM   " },
    { "type": "swap", "key": "SWAP  " },
    { "type": "disk", "key": "DISK  ", "folders": "/" },
    "break",
    { "type": "os", "key": "OS    " },
    { "type": "wm", "key": "WM    " },
    { "type": "shell", "key": "SHELL " },
    { "type": "terminal", "key": "TERM  " },
    { "type": "packages", "key": "PKGS  " },
    "break",
    { "type": "uptime", "key": "UPTIME" },
    { "type": "command", "key": "DATE  ", "text": "date '+%F %T'" },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 2
    }
  ]
}