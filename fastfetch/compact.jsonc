{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/pokemon.png",
    "width": 18,
    "height": 9,
    "padding": {
      "top": 1,
      "left": 1,
      "right": 2
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;127;183;164",
      "title": "38;2;127;183;164"
    }
  },
  "modules": [
    { "type": "title", "format": "{user-name}@{host-name}" },
    { "type": "os", "key": "󰣇", "format": "{name}" },
    { "type": "wm", "key": "󰖲", "format": "{pretty-name}" },
    { "type": "shell", "key": "󰆍", "format": "{pretty-name}" },
    { "type": "terminal", "key": "󰆍", "format": "{pretty-name}" },
    { "type": "uptime", "key": "󰅐" },
    { "type": "packages", "key": "󰏖", "format": "{all}" },
    { "type": "memory", "key": "󰍛", "format": "{used} / {total}" },
    { "type": "colors", "symbol": "circle" }
  ]
}
